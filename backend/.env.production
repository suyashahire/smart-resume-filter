# =============================================================================
# HireQ Backend — Production Environment Variables
# =============================================================================
# Copy to .env and fill in actual values:
#   cp .env.production .env && nano .env
# =============================================================================

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production

# Database (MongoDB Atlas — get URI from Atlas dashboard)
MONGODB_URI=mongodb+srv://hireq_app:<PASSWORD>@hireq-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=hireq

# JWT Authentication — generate secret with: openssl rand -hex 64
JWT_SECRET_KEY=<PASTE_64_CHAR_HEX_SECRET_HERE>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL (CORS — no trailing slash)
FRONTEND_URL=https://hireq.tech

# AI Chatbot (Google Gemini — free at aistudio.google.com/apikey)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Email (Resend — free at resend.com)
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
FROM_EMAIL=noreply@hireq.tech

# ML Models
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
