# =============================================================================
# HireQ Frontend - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# Backend API URL (must include the /api prefix)
# Development: http://localhost:8000/api
# Production:  https://api.hireq.tech/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Frontend App URL (for sharing, callbacks, etc.)
# Development: http://localhost:3000
# Production:  https://hireq.tech
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket URL for real-time updates
# Development: (auto-derived from API URL)
# Production:  wss://api.hireq.tech/api/realtime
# NEXT_PUBLIC_WS_URL=wss://api.hireq.tech/api/realtime

# API host (used for CSP connect-src header)
# Development: (auto-derived)
# Production:  api.hireq.tech
# NEXT_PUBLIC_API_HOST=api.hireq.tech
